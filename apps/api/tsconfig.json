{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@ayu/shared-types": ["../../../packages/shared-types/src/index.ts"],
      "@ayu/shared-types/*": ["../../../packages/shared-types/src/*"]
    },
    "incremental": true,
    "strictNullChecks": true
  }
}

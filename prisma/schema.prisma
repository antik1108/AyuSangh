generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  PLATFORM_ADMIN
}

enum InstitutionType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTRE
  NURSING_HOME
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id                    String          @id @default(uuid())
  email                 String          @unique
  passwordHash          String
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  role                  Role            @default(PATIENT)
  firstName             String?
  lastName              String?
  profilePhoto          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  hospitals      Hospital[]
  doctorProfile  Doctor?
  reviews        Review[]
  communityPosts CommunityPost[]
  favourites     Favourite[]
}

// ─────────────────────────────────────────────
// Location
// ─────────────────────────────────────────────

model Location {
  id        String   @id @default(uuid())
  address   String
  city      String
  state     String
  zipCode   String
  country   String
  latitude  Float?
  longitude Float?

  hospital Hospital?

  @@index([city])
  @@index([state])
}

// ─────────────────────────────────────────────
// Hospital (Institution)
// ─────────────────────────────────────────────

model Hospital {
  id              String          @id @default(uuid())
  name            String
  description     String?
  institutionType InstitutionType @default(HOSPITAL)
  adminId         String
  admin           User            @relation(fields: [adminId], references: [id])
  locationId      String          @unique
  location        Location        @relation(fields: [locationId], references: [id])

  // Contact & discovery
  phone        String?
  website      String?
  email        String?
  bookingLink  String?   // FR-02.5 — booking redirect link
  pincode      String?   // FR-02.2 — Indian pincode for search

  // Services offered (e.g. ["MRI", "Blood Test", "ICU"])
  services     String[]  @default([])

  // Opening hours (e.g. "Mon-Sat 8am-8pm, Sun 9am-2pm")
  openingHours String?   // FR-05.2 — open status filter support

  // Cached aggregate ratings (updated on review approval)
  rating                Float?  // overall cached average
  ratingCleanliness     Float?
  ratingStaffBehaviour  Float?
  ratingWaitTime        Float?

  profilePhoto String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  departments    Department[]
  accreditations Accreditation[]
  costs          Cost[]
  reviews        Review[]
  doctors        DoctorInstitution[]
  images         InstitutionImage[]
  favourites     Favourite[]

  @@index([name])
  @@index([institutionType])
}

// ─────────────────────────────────────────────
// Doctor
// ─────────────────────────────────────────────

model Doctor {
  id              String   @id @default(uuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  firstName       String
  lastName        String
  specialization  String
  experienceYears Int
  bio             String?
  phone           String?
  profilePhoto    String?

  // FR-03.1 — qualifications and consultation fee
  qualifications  String[]  @default([])  // e.g. ["MBBS", "MD", "FRCS"]
  consultationFee Float?                  // in INR

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews      Review[]
  institutions DoctorInstitution[]

  @@index([specialization])
}

// ─────────────────────────────────────────────
// Review  (multi-dimensional — FR-04.2)
// ─────────────────────────────────────────────

model Review {
  id     String @id @default(uuid())
  text   String?

  // FR-04.2 — four separate rating dimensions (1–5 each)
  ratingOverall        Int  // required — primary sort key
  ratingCleanliness    Int
  ratingStaffBehaviour Int
  ratingWaitTime       Int

  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  doctorId   String?
  doctor     Doctor?   @relation(fields: [doctorId], references: [id])

  status       ReviewStatus @default(PENDING)
  adminReply   String?
  adminReplyAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, hospitalId, doctorId], name: "unique_review_per_entity")
  @@index([hospitalId])
  @@index([doctorId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Supporting models
// ─────────────────────────────────────────────

model Department {
  id         String   @id @default(uuid())
  name       String
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
}

model Accreditation {
  id         String    @id @default(uuid())
  name       String
  issueDate  DateTime
  expiryDate DateTime?
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id])
}

model Cost {
  id            String   @id @default(uuid())
  procedureName String
  estimatedCost Float
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id])
}

model CommunityPost {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Many-to-Many: Doctor ↔ Institution
model DoctorInstitution {
  id         String   @id @default(uuid())
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([doctorId, hospitalId])
  @@index([doctorId])
  @@index([hospitalId])
}

// User's favourite institutions
model Favourite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([userId, hospitalId])
  @@index([userId])
  @@index([hospitalId])
}

// Institution images
model InstitutionImage {
  id             String   @id @default(uuid())
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  imageUrl       String
  altText        String?
  isProfilePhoto Boolean  @default(false)
  uploadedAt     DateTime @default(now())

  @@index([hospitalId])
}

// Refresh tokens for secure token rotation
model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userEmail String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userEmail])
  @@index([expiresAt])
}

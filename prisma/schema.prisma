// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  PLATFORM_ADMIN
}

enum InstitutionType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTRE
  NURSING_HOME
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  refreshToken   String?         // For refresh token flow
  refreshTokenExpiresAt DateTime? // Refresh token expiry
  role           Role            @default(PATIENT)
  firstName      String?
  lastName       String?
  profilePhoto   String?         // URL to Cloudinary or storage
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  hospitals      Hospital[]      // If role is HOSPITAL_ADMIN
  doctorProfile  Doctor?
  reviews        Review[]
  communityPosts CommunityPost[]
  favourites     Favourite[]     // Favourite institutions
}

model Location {
  id        String    @id @default(uuid())
  address   String
  city      String
  state     String
  zipCode   String
  country   String
  latitude  Float?
  longitude Float?
  
  hospital  Hospital?

  @@index([city])
  @@index([state])
}

model Hospital {
  id               String          @id @default(uuid())
  name             String
  description      String?
  institutionType  InstitutionType @default(HOSPITAL)
  adminId          String
  admin            User            @relation(fields: [adminId], references: [id])
  locationId       String          @unique
  location         Location        @relation(fields: [locationId], references: [id])
  rating           Float?          // Cached average rating
  isActive         Boolean         @default(true)
  phone            String?
  website          String?
  email            String?
  profilePhoto     String?         // URL to profile photo
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  departments      Department[]
  accreditations   Accreditation[]
  costs            Cost[]
  reviews          Review[]
  doctors          DoctorInstitution[] // M2M relationship to doctors
  images           InstitutionImage[]
  favourites       Favourite[]
}

model Doctor {
  id              String   @id @default(uuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  firstName       String
  lastName        String
  specialization  String
  experienceYears Int
  bio             String?
  phone           String?
  profilePhoto    String?  // URL to Cloudinary or storage
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews         Review[]
  institutions    DoctorInstitution[] // M2M relationship to institutions
}

model Department {
  id          String   @id @default(uuid())
  name        String
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
}

model Accreditation {
  id          String   @id @default(uuid())
  name        String
  issueDate   DateTime
  expiryDate  DateTime?
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
}

model Cost {
  id             String   @id @default(uuid())
  procedureName  String
  estimatedCost  Float
  hospitalId     String
  hospital       Hospital @relation(fields: [hospitalId], references: [id])
}

model Review {
  id             String        @id @default(uuid())
  rating         Int
  text           String?
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  hospitalId     String?
  hospital       Hospital?     @relation(fields: [hospitalId], references: [id])
  doctorId       String?
  doctor         Doctor?       @relation(fields: [doctorId], references: [id])
  status         ReviewStatus  @default(PENDING)
  adminReply     String?       // Admin's reply to review
  adminReplyAt   DateTime?     // When admin replied
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Composite unique constraint: one review per patient per institution per doctor
  @@unique([authorId, hospitalId, doctorId], name: "unique_review_per_entity")
}

model CommunityPost {
  id          String   @id @default(uuid())
  title       String
  content     String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Many-to-Many: Doctor to Institution relationship
model DoctorInstitution {
  id            String    @id @default(uuid())
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId    String
  hospital      Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  joinedAt      DateTime  @default(now())
  
  @@unique([doctorId, hospitalId])
  @@index([doctorId])
  @@index([hospitalId])
}

// User's favourite institutions
model Favourite {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  addedAt     DateTime  @default(now())
  
  @@unique([userId, hospitalId])
  @@index([userId])
  @@index([hospitalId])
}

// Institution images uploaded to Cloudinary
model InstitutionImage {
  id          String    @id @default(uuid())
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  imageUrl    String    // Cloudinary URL
  altText     String?   // For accessibility
  isProfilePhoto Boolean @default(false)
  uploadedAt  DateTime  @default(now())
  
  @@index([hospitalId])
}

// Refresh tokens for secure token rotation
model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userEmail String    // Store email for lookups during token validation
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  
  @@index([userEmail])
  @@index([expiresAt])
}

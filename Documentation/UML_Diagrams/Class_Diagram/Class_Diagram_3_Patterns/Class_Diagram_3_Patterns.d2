direction: right

# ═══════════════════════════════════════
# AyuSangh — Class Diagram 3 of 3
# Design Patterns & Infrastructure
# Strategy, Repository, Guards, Services
# ═══════════════════════════════════════

# ─────────────────────────────
# STRATEGY PATTERN
# ─────────────────────────────

IRatingStrategy: {
  shape: class
  style.fill: "#e8f5e9"
  style.stroke-dash: 4
  "<<interface>>": ""
  +calculateAverage(reviews: ReviewArray): AggregatedScore
}

AggregatedScore: {
  shape: class
  style.fill: "#e8f5e9"
  style.stroke-dash: 4
  "<<interface>>": ""
  +overall: Float
  +cleanliness: Float
  +staffBehaviour: Float
  +waitTime: Float
  +reviewCount: Int
}

DefaultRatingStrategy: {
  shape: class
  style.fill: "#c8e6c9"
  +calculateAverage(reviews: ReviewArray): AggregatedScore
}

HospitalRatingStrategy: {
  shape: class
  style.fill: "#c8e6c9"
  +calculateAverage(reviews: ReviewArray): AggregatedScore
}

LabRatingStrategy: {
  shape: class
  style.fill: "#c8e6c9"
  +calculateAverage(reviews: ReviewArray): AggregatedScore
}

RatingContext: {
  shape: class
  style.fill: "#a5d6a7"
  -strategies: Map
  -defaultStrategy: DefaultRatingStrategy
  +register(type: InstitutionType): void
  +calculate(reviews: ReviewArray): AggregatedScore
}

# ─────────────────────────────
# REPOSITORY PATTERN
# ─────────────────────────────

BaseRepository: {
  shape: class
  style.fill: "#e3f2fd"
  style.stroke-dash: 4
  "<<abstract>>": ""
  +findById(id: String): T
  +findAll(): T
  +create(data: Object): T
  +update(id: String): T
  +delete(id: String): T
}

DatabaseService: {
  shape: class
  style.fill: "#bbdefb"
  -prismaClient: PrismaClient
  +user: UserDelegate
  +hospital: HospitalDelegate
  +doctor: DoctorDelegate
  +review: ReviewDelegate
  +favourite: FavouriteDelegate
  +institutionImage: ImageDelegate
  +location: LocationDelegate
  +onModuleInit(): void
  +onModuleDestroy(): void
}

HospitalRepository: {
  shape: class
  style.fill: "#e3f2fd"
  +searchHospitals(nameQuery: String): HospitalArray
  +updateInstitution(hospitalId: String, data: Object): Hospital
  +updateInstitutionRating(hospitalId: String, scores: Object): Hospital
  +findApprovedReviews(hospitalId: String): ReviewArray
  +updateProfilePhoto(hospitalId: String): Hospital
  +addImages(hospitalId: String): Object
  +findImage(imageId: String): InstitutionImage
  +deleteImage(imageId: String): InstitutionImage
}

ReviewRepository: {
  shape: class
  style.fill: "#e3f2fd"
  +findByHospital(hospitalId: String): ReviewArray
  +findByDoctor(doctorId: String): ReviewArray
  +updateStatus(reviewId: String): Review
  +addAdminReply(reviewId: String): Review
  +findPending(): ReviewArray
}

DoctorRepository: {
  shape: class
  style.fill: "#e3f2fd"
  +searchDoctors(query: String): DoctorArray
}

CommunityRepository: {
  shape: class
  style.fill: "#e3f2fd"
  +findAll(): PostArray
  +create(data: Object): CommunityPost
}

CostRepository: {
  shape: class
  style.fill: "#e3f2fd"
  +findAll(): CostArray
}

# ─────────────────────────────
# INFRASTRUCTURE SERVICES
# ─────────────────────────────

CloudinaryService: {
  shape: class
  style.fill: "#fce4ec"
  +uploadImage(file: MulterFile): UploadResult
  +deleteImage(publicId: String): void
}

TransformInterceptor: {
  shape: class
  style.fill: "#fce4ec"
  "<<interceptor>>": ""
  +intercept(context: ExecutionContext): Observable
}

AllExceptionsFilter: {
  shape: class
  style.fill: "#fce4ec"
  "<<filter>>": ""
  +catch(exception: unknown): void
}

# ─────────────────────────────
# AUTH GUARDS
# ─────────────────────────────

JwtAuthGuard: {
  shape: class
  style.fill: "#fff9c4"
  "<<guard>>": ""
  +canActivate(context: ExecutionContext): Boolean
}

RolesGuard: {
  shape: class
  style.fill: "#fff9c4"
  "<<guard>>": ""
  +canActivate(context: ExecutionContext): Boolean
}

JwtStrategy: {
  shape: class
  style.fill: "#fff9c4"
  "<<strategy>>": ""
  +validate(payload: JwtPayload): AuthUser
}

LocalStrategy: {
  shape: class
  style.fill: "#fff9c4"
  "<<strategy>>": ""
  +validate(email: String): AuthUser
}

# ─── Strategy Pattern relationships ───
DefaultRatingStrategy -> IRatingStrategy: "implements"
HospitalRatingStrategy -> IRatingStrategy: "implements"
LabRatingStrategy -> IRatingStrategy: "implements"
IRatingStrategy -> AggregatedScore: "returns"
RatingContext -> IRatingStrategy: "uses"
RatingContext -> DefaultRatingStrategy: "default"

# ─── Repository Pattern relationships ───
HospitalRepository -> BaseRepository: "extends"
ReviewRepository -> BaseRepository: "extends"
DoctorRepository -> BaseRepository: "extends"
CommunityRepository -> BaseRepository: "extends"
CostRepository -> BaseRepository: "extends"
HospitalRepository -> DatabaseService: "injects"
ReviewRepository -> DatabaseService: "injects"
DoctorRepository -> DatabaseService: "injects"
CommunityRepository -> DatabaseService: "injects"
CostRepository -> DatabaseService: "injects"

# ─── Guard relationships ───
JwtAuthGuard -> JwtStrategy: "uses"

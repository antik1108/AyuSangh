
# ─────────────────────────────
# SEARCH MODULE
# ─────────────────────────────

SearchController: {
  shape: class
  style.fill: "#ede7f6"
  globalSearch(query)
  advancedSearch(query, type, limit, offset)
  advancedHospitalSearch(options)
  advancedDoctorSearch(options)
  findNearby(lat, lng, radiusKm)
  getHospitalsByFilters(filters)
  getTrendingSearches(limit)
}

SearchService: {
  shape: class
  style.fill: "#ede7f6"
  cache
  globalSearch(query)
  cleanupTestData()
}

AdvancedSearchService: {
  shape: class
  style.fill: "#ede7f6"
  search(options)
  advancedHospitalSearch(options)
  advancedDoctorSearch(options)
  getTrendingSearches(limit)
  findNearby(options)
  getHospitalsByFilters(filters)
}

# ─────────────────────────────
# COMMUNITY MODULE
# ─────────────────────────────

CommunityController: {
  shape: class
  style.fill: "#e8eaf6"
  getAllPosts()
  createPost(data, req)
}

CommunityService: {
  shape: class
  style.fill: "#e8eaf6"
  getAllPosts()
  createPost(data)
}

CommunityRepository: {
  shape: class
  style.fill: "#e8eaf6"
  findAll()
  create(data)
}

# ─────────────────────────────
# COST MODULE
# ─────────────────────────────

CostController: {
  shape: class
  style.fill: "#f1f8e9"
  getAll()
}

CostService: {
  shape: class
  style.fill: "#f1f8e9"
  getAll()
}

CostRepository: {
  shape: class
  style.fill: "#f1f8e9"
  findAll()
}

# ═══════════════════════════════════════
# RELATIONSHIPS
# ═══════════════════════════════════════

User -> Hospital: "1 to many"
User -> Doctor: "0 to 1"
User -> Review: "1 to many"
User -> CommunityPost: "1 to many"
User -> Favourite: "1 to many"
Hospital -> Location: "1 to 1"
Hospital -> Department: "1 to many"
Hospital -> Accreditation: "1 to many"
Hospital -> Cost: "1 to many"
Hospital -> Review: "1 to many"
Hospital -> InstitutionImage: "1 to many"
Hospital -> Favourite: "1 to many"
Doctor -> Review: "1 to many"
DoctorInstitution -> Doctor: "many to 1"
DoctorInstitution -> Hospital: "many to 1"
Review -> ReviewStatus: "uses"
Hospital -> InstitutionType: "uses"
User -> Role: "uses"

HospitalRepository -> BaseRepository: "extends"
ReviewRepository -> BaseRepository: "extends"
DoctorRepository -> BaseRepository: "extends"
CommunityRepository -> BaseRepository: "extends"
CostRepository -> BaseRepository: "extends"

DefaultRatingStrategy -> IRatingStrategy: "implements"
RatingContext -> IRatingStrategy: "uses"
RatingContext -> DefaultRatingStrategy: "injects"
IRatingStrategy -> AggregatedScore: "returns"

AuthController -> AuthService: "injects"
AuthService -> UsersService: "injects"
AuthService -> DatabaseService: "injects"
LocalStrategy -> AuthService: "injects"
JwtAuthGuard -> JwtStrategy: "uses"
RolesGuard -> Role: "uses"

HospitalController -> HospitalService: "injects"
HospitalController -> FavouritesService: "injects"
HospitalController -> CloudinaryService: "injects"
HospitalService -> HospitalRepository: "injects"
HospitalRepository -> DatabaseService: "injects"
FavouritesService -> DatabaseService: "injects"

DoctorController -> DoctorService: "injects"
DoctorService -> DoctorRepository: "injects"
DoctorRepository -> DatabaseService: "injects"

ReviewController -> ReviewService: "injects"
ReviewService -> ReviewRepository: "injects"
ReviewService -> RatingContext: "injects"
ReviewRepository -> DatabaseService: "injects"

SearchController -> SearchService: "injects"
SearchController -> AdvancedSearchService: "injects"
SearchService -> HospitalService: "injects"
SearchService -> DoctorService: "injects"
AdvancedSearchService -> DatabaseService: "injects"

CommunityController -> CommunityService: "injects"
CommunityService -> CommunityRepository: "injects"
CommunityRepository -> DatabaseService: "injects"

CostController -> CostService: "injects"
CostService -> CostRepository: "injects"
CostRepository -> DatabaseService: "injects"


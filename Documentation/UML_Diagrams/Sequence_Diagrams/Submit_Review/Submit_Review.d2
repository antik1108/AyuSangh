shape: sequence_diagram

Browser
Controller
Guard
Service
Repo
DB

Browser -> Controller: "POST /reviews {text, ratings, institutionId}"
Controller -> Guard: "validate JWT token"
Guard -> Controller: "userId extracted from token"
Controller -> Controller: "validate DTO (class-validator)"
Controller -> Service: "createReview(userId, dto)"
Service -> Repo: "findByUserAndInstitution(userId, institutionId)"
Repo -> DB: "SELECT from Review WHERE userId AND institutionId"
DB -> Repo: "query result"
Repo -> Service: "null - no duplicate found"
Service -> Repo: "create(reviewData)"
Repo -> DB: "INSERT INTO Review"
DB -> Repo: "saved Review row"
Repo -> Service: "Review object"
Service -> Service: "RatingStrategy.calculate() - update averageRating"
Service -> Repo: "updateInstitutionRating(institutionId, newAvg)"
Repo -> DB: "UPDATE Institution SET averageRating"
DB -> Repo: "updated"
Repo -> Service: "Institution updated"
Service -> Controller: "ReviewResponseDto"
Controller -> Browser: "HTTP 201 Created"

shape: sequence_diagram

Browser
Controller
Guard
Service
Repo
DB
Cloudinary

Browser -> Controller: "PATCH /institutions/:id {description, phone, bookingLink}"
Controller -> Guard: "validate JWT token"
Guard -> Controller: "userId + role extracted"
Controller -> Guard: "check role is INSTITUTION_ADMIN"
Guard -> Controller: "role verified"
Controller -> Service: "updateInstitution(userId, institutionId, dto)"
Service -> Repo: "findById(institutionId)"
Repo -> DB: "SELECT from Institution WHERE id"
DB -> Repo: "Institution row"
Repo -> Service: "Institution object"
Service -> Service: "verify userId owns this institution"
Service -> Repo: "update(institutionId, updateData)"
Repo -> DB: "UPDATE Institution SET ..."
DB -> Repo: "updated Institution row"
Repo -> Service: "updated Institution object"
Service -> Controller: "InstitutionResponseDto"
Controller -> Browser: "HTTP 200 OK - updated institution"
shape: sequence_diagram

Browser
Controller
Guard
Service
Repo
DB
Cache

Browser -> Controller: "GET /institutions?city=Noida&type=HOSPITAL"
Controller -> Cache: "check cache key city:Noida:HOSPITAL"
Cache -> Controller: "cache miss"
Controller -> Service: "searchInstitutions(city, type, filters)"
Service -> Repo: "findByFilters(city, type, rating)"
Repo -> DB: "SELECT from Institution WHERE city AND type ORDER BY averageRating DESC"
DB -> Repo: "Institution rows"
Repo -> Service: "Institution[] array"
Service -> Service: "map to InstitutionSummaryDto[]"
Service -> Controller: "InstitutionSummaryDto[]"
Controller -> Cache: "set cache key city:Noida:HOSPITAL TTL 5min"
Cache -> Controller: "cached"
Controller -> Browser: "HTTP 200 OK - institutions array"
{
  "name": "ayu-sangh-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "bash dev.sh",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",

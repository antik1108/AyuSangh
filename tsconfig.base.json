{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ayu/shared-types": ["packages/shared-types/src/index.ts"],
      "@ayu/shared-types/*": ["packages/shared-types/src/*"]
    }
  }
}
